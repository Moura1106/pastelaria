# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sem DATABASE_URL, usa o SQLite local (pastelaria.db).
# Produção (PythonAnywhere) — use uma senha do MySQL só com letras e números:
# DATABASE_URL=mysql+pymysql://SEU_USUARIO:SENHA_DO_MYSQL@SEU_USUARIO.mysql.pythonanywhere-services.com/SEU_USUARIO$pastelaria?charset=utf8mb4
# COOKIE_SECURE=1

# Assistente "Perguntar" (opcional). Chave criada em console.anthropic.com; sem ela a tela não aparece no menu.
# ANTHROPIC_API_KEY=
# Modelo usado (padrão: claude-haiku-5-5, o mais barato). Para respostas mais elaboradas: claude-sonnet-5-5
# MODELO_ASSISTENTE=
